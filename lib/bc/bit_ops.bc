/*
Bit =~ 0 | 1;

bits = Bit[(N a NNeg) ..= 0];

mod not {
    N: Integer;
    [i: bits (N - 1)..0]
}

not =~ b: Bit -> r: Bit = 
    | b r 
    | 0 1
    | 1 0  ;

not =~ b * 8..0i < 8: [Bit; 8] -> [Bit; 8] = 
    | b | _ |
    | 0 | 1 |
    | 1 | 0 |
*/
