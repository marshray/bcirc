/*
PositiveIntegerBase10LeadingDigit =~ 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8 | 9;

PositiveIntegerBase10SubsequentDigit =~ 0 | PositiveIntegerBase10LeadingDigit;

PositiveInteger =~
      ( PositiveIntegerBase10LeadingDigit PositiveIntegerBase10SubsequentDigit* )
    | PositiveInteger + NonnegativeInteger
    | PositiveInteger * PositiveInteger  
    | NegativeInteger * NegativeInteger
    | PositiveInteger ** NonnegativeInteger
    | NegativeInteger ** PositiveEvenInteger;

NonnegativeEvenInteger =~
      NonnegativeInteger
    & 2 * NonnegativeInteger;

PositiveOddInteger =~
      PositiveInteger
    & NonnegativeEvenInteger + 1;

NonnegativeOddInteger =~ PositiveOddInteger;

PositiveEvenInteger =~
      PositiveInteger
    & PositiveOddInteger + 1;

NegativeInteger =~ -PositiveInteger;

NonnegativeInteger =~
      0
    | PositiveInteger
    | NonnegativeInteger + NonnegativeInteger
    | NonnegativeInteger * NonnegativeInteger
    | NegativeInteger * NegativeInteger
    | NonnegativeInteger ** PositiveInteger;

NonpositiveInteger =~ NegativeInteger | 0;

Integer =~
      NegativeInteger
    | NonnegativeInteger
    | Integer + Integer
    | Integer - Integer
    | Integer * Integer
    | Integer ** PositiveInteger;

{ Quotient =~ NonnegativeInteger, Remainder =~ NonnegativeInteger(_ < Denominator) }
    =~ (Numerator =~ NonnegativeInteger)/(Denominator =~ PostiveInteger);

OneBasedOrdinal =~ PositiveInteger;

ZeroBasedOrdinal =~ NonnegativeInteger;
*/